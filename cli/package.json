{
	"name": "@evidence/cli",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"build:sandbox": "node ../core/scripts/build-sandbox-runtimes.js --out static/sandbox",
		"dev": "pnpm run build:sandbox && vite dev",
		"build": "pnpm run build:sandbox && bun run scripts/bundle-docs.ts && NODE_OPTIONS=\"--max-old-space-size=8192\" vite build",
		"preview": "vite preview",
		"test": "vitest run",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && pnpm check:cli",
		"check:cli": "svelte-kit sync && tsc -p tsconfig.cli.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint ."
	},
	"devDependencies": {
		"@eslint/compat": "^1.4.0",
		"@eslint/js": "^9.39.1",
		"@fontsource/fira-mono": "^5.2.7",
		"@neoconfetti/svelte": "^2.2.2",
		"@sveltejs/kit": "^2.59.1",
		"@sveltejs/vite-plugin-svelte": "^6.2.1",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.1.17",
		"@types/bun": "^1.3.14",
		"@types/js-yaml": "^4.0.9",
		"@types/mssql": "^12.3.0",
		"@types/node": "^22",
		"@types/pg": "^8.11.10",
		"@types/semver": "^7.7.1",
		"eslint": "^9.39.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.13.1",
		"globals": "^16.5.0",
		"prettier": "^3.7.4",
		"prettier-plugin-svelte": "^3.4.0",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"svelte": "^5.53.5",
		"svelte-check": "^4.3.4",
		"tailwindcss": "^4.1.17",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.48.1",
		"vite": "^7.3.2"
	},
	"dependencies": {
		"@azure/identity": "^4.5.0",
		"@clack/prompts": "^0.11.0",
		"@clickhouse/client": "^1.11.0",
		"@databricks/sql": "^1.16.0",
		"@evidence/core": "workspace:*",
		"@google-cloud/bigquery": "^7.9.0",
		"@markdoc/markdoc": "npm:@hughess/markdoc@^0.0.0-evidence.29",
		"@workos-inc/node": "^7.77.0",
		"cli-table3": "^0.6.5",
		"html-to-image": "^1.11.13",
		"js-base64": "^3.7.7",
		"js-yaml": "^4.3.0",
		"lucide-svelte": "^0.544.0",
		"mode-watcher": "^1.0.8",
		"mssql": "^11.0.1",
		"pg": "^8.14.1",
		"picocolors": "^1.1.1",
		"runed": "^0.31.1",
		"semver": "^7.7.4",
		"snowflake-sdk": "^2.3.6",
		"svelte-sonner": "^1.0.5"
	}
}
