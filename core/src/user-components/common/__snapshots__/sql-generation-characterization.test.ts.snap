exports[`generateSQLQuery — bigquery > search + pagination 1`] = `
"SELECT * FROM (SELECT category AS \`category\`, sum(sales) AS \`sum_sales\`
 FROM orders
 
 GROUP BY ALL
 
 
 
 LIMIT 2000) AS evidence_paged WHERE (LOWER(CAST(\`category\` AS STRING)) LIKE LOWER('%abc%') OR LOWER(CAST(\`sum_sales\` AS STRING)) LIKE LOWER('%abc%')) LIMIT 10 OFFSET 20"
`;

exports[`generateSQLQuery — bigquery > subtotals table 1`] = `
"SELECT category AS \`category\`, region AS \`region\`, sum(sales) AS \`sum_sales\`, GROUPING(category) AS \`__ev_grouping_category\`, GROUPING(region) AS \`__ev_grouping_region\`, CASE WHEN GROUPING(category) + GROUPING(region) = 2 AND 0 = 0 THEN 0 WHEN GROUPING(category) = 0 AND GROUPING(region) = 1 THEN 1 WHEN GROUPING(category) = 1 AND GROUPING(region) = 1 THEN 0 ELSE NULL END AS \`__ev_subtotal_level\`, CASE
 WHEN (CASE WHEN GROUPING(category) + GROUPING(region) = 2 AND 0 = 0 THEN 0 WHEN GROUPING(category) = 0 AND GROUPING(region) = 1 THEN 1 WHEN GROUPING(category) = 1 AND GROUPING(region) = 1 THEN 0 ELSE NULL END) IS NULL THEN 'cell_data'
 WHEN (CASE WHEN GROUPING(category) + GROUPING(region) = 2 AND 0 = 0 THEN 0 WHEN GROUPING(category) = 0 AND GROUPING(region) = 1 THEN 1 WHEN GROUPING(category) = 1 AND GROUPING(region) = 1 THEN 0 ELSE NULL END) = 0 THEN 'row_total'
 ELSE 'row_subtotal'
 END AS \`__ev_render_type\`
 FROM orders
 
 GROUP BY GROUPING SETS ((category, region), (category), ())"
`;

