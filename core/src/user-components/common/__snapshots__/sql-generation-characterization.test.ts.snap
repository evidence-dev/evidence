exports[`generateSQLQuery with filters — bigquery > routes column-bound filter predicates into the WHERE clause 1`] = `
"SELECT category AS \`category\`, sum(sales) AS \`sum_sales\`
 FROM orders
 WHERE (category='O\\'Brien' AND region IN ('East', 'West'))
		GROUP BY ALL
		
		
		ORDER BY category desc LIMIT 100"
`;

