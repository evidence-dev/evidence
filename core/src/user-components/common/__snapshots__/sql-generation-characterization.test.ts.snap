exports[`applyAggregateFilter — bigquery > distributes a predicate across a compound measure 1`] = `"sum(CASE WHEN order_date >= '2024-01-01' THEN sales END) / nullif(sum(CASE WHEN order_date >= '2024-01-01' THEN quantity END), 0)"`;

